<style>
  .uix-hand-menu {
    display: flex;
    flex-direction: column;
    background-color: rgba(16, 26, 38, 0.92);
    border-color: #2e4a66;
    border-width: 0.75;
    border-radius: 10;
    padding: 6;
  }
  .uix-hand-menu-stack { display: flex; flex-direction: column; }
  .uix-hand-menu-button {
    width: 120;
    padding: 6;
    margin-top: 3;
    font-size: 10;
    font-weight: bold;
    text-align: center;
    justify-content: center;
    color: #ffffff;
    background-color: #2c4a6b;
    border-radius: 6;
    cursor: pointer;
  }
  .uix-hand-menu-button:hover { background-color: #3d648e; }
  .uix-hand-menu-button:active { background-color: #1f3a55; }
  .uix-hand-menu-title { font-size: 8.5; color: #7d94ad; margin-bottom: 2; }
  .status { width: 120; font-size: 8; color: #9fb8d4; margin-top: 5; }
</style>
<div id="uix-window" class="uix-hand-menu">
  <div id="uix-content" class="uix-hand-menu-stack">
    <span class="uix-hand-menu-title">Player Status</span>
    <div id="ctl-hide" class="uix-hand-menu-button">HIDE</div>
    <div id="ctl-pin" class="uix-hand-menu-button">PIN</div>
    <div id="ctl-belt" class="uix-hand-menu-button">TO BELT</div>
    <div id="ctl-wall" class="uix-hand-menu-button">TO WALL</div>
    <div id="ctl-undock" class="uix-hand-menu-button">UNDOCK</div>
    <div id="ctl-home" class="uix-hand-menu-button">HOME</div>
    <div id="ctl-minimize" class="uix-hand-menu-button">MIN</div>
    <div id="ctl-chrome" class="uix-hand-menu-button">BUTTONS OFF</div>
    <span id="ctl-status" class="status">.</span>
  </div>
</div>
