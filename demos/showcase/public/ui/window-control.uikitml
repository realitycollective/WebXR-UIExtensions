<style>
  .uix-window {
    display: flex;
    flex-direction: column;
    width: 260;
    background-color: rgba(16, 26, 38, 0.92);
    border-color: #2e4a66;
    border-width: 0.75;
    border-radius: 12.5;
  }
  .uix-titlebar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8;
    background-color: #1b2c40;
    border-top-left-radius: 12.5;
    border-top-right-radius: 12.5;
    cursor: pointer;
  }
  .uix-titlebar:hover { background-color: #24405e; }
  .uix-title { flex-shrink: 1; font-size: 12; font-weight: bold; color: #dce9f7; }
  .uix-titlebar-buttons { display: flex; flex-direction: row; flex-shrink: 0; }
  .uix-titlebar-button {
    width: 34;
    height: 20;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-left: 4;
    font-size: 9;
    color: #9fb8d4;
    background-color: #223850;
    border-radius: 6;
    cursor: pointer;
  }
  .uix-titlebar-button:hover { background-color: #33547a; color: #ffffff; }
  .uix-content { display: flex; flex-direction: column; width: 100%; padding: 10; }
  .hint { font-size: 9.5; color: #7d94ad; margin-bottom: 6; }
  .grid { display: flex; flex-direction: row; flex-wrap: wrap; width: 100%; }
  .control-button {
    width: 48%;
    margin: 1%;
    padding: 8;
    font-size: 10.5;
    font-weight: bold;
    text-align: center;
    justify-content: center;
    color: #ffffff;
    background-color: #2c4a6b;
    border-radius: 8;
    cursor: pointer;
  }
  .control-button:hover { background-color: #3d648e; }
  .control-button:active { background-color: #1f3a55; }
  .status { font-size: 9.5; color: #9fb8d4; margin-top: 8; }
</style>
<div id="uix-window" class="uix-window">
  <div id="uix-titlebar" class="uix-titlebar">
    <span id="uix-title" class="uix-title">.</span>
    <div class="uix-titlebar-buttons">
      <div id="uix-pin" class="uix-titlebar-button">PIN</div>
      <div id="uix-dock" class="uix-titlebar-button">DOCK</div>
      <div id="uix-minimize" class="uix-titlebar-button">MIN</div>
      <div id="uix-close" class="uix-titlebar-button">X</div>
    </div>
  </div>
  <div id="uix-content" class="uix-content">
    <span class="hint">Drives "Player Status" through the WindowManager - what a hand menu would call.</span>
    <div class="grid">
      <div id="ctl-hide" class="control-button">HIDE</div>
      <div id="ctl-pin" class="control-button">PIN</div>
      <div id="ctl-belt" class="control-button">TO BELT</div>
      <div id="ctl-wall" class="control-button">TO WALL</div>
      <div id="ctl-undock" class="control-button">UNDOCK</div>
      <div id="ctl-home" class="control-button">HOME</div>
      <div id="ctl-minimize" class="control-button">MIN</div>
      <div id="ctl-chrome" class="control-button">BUTTONS OFF</div>
    </div>
    <span id="ctl-status" class="status">.</span>
  </div>
</div>
