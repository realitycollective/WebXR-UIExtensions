{
  "core": "webxr-uiextensions",
  "packages": [
    "webxr-uiextensions",
    "iwsdk-uiextensions",
    "xrblocks-uiextensions",
    "uix-devtools"
  ],
  "importCheck": [
    "webxr-uiextensions"
  ],
  "declarationCheck": true,
  "binSmoke": [
    {
      "package": "uix-devtools",
      "bin": "uix-dev",
      "args": ["help"],
      "match": "uix-dev"
    }
  ],
  "legacyPeerDeps": true,
  "preid": "preview",
  "prebundle": {
    "bundlers": [
      {
        "id": "vite7",
        "package": "vite-7",
        "detectsStarHops": true
      },
      {
        "id": "vite8",
        "package": "vite-8",
        "detectsStarHops": false
      }
    ],
    "packages": {
      "iwsdk-uiextensions": {
        "hosts": [
          "@iwsdk/core"
        ]
      }
    }
  }
}
