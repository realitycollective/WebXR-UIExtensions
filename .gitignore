*.pid
*.seed
*.pid.lock

# Output of `npm pack`
*.tgz
dist-tarballs/

# Environment / secrets
.env
.env.*
!.env.example

# Caches
.npm/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
