<style>
  .uix-hand-menu {
    display: flex;
    flex-direction: column;
    background-color: rgba(16, 26, 38, 0.92);
    border-color: #2e4a66;
    border-width: 0.75;
    border-radius: 10;
    padding: 6;
  }
  .uix-hand-menu-stack { display: flex; flex-direction: column; }
  .uix-hand-menu-button {
    width: 110;
    padding: 6;
    margin-top: 3;
    font-size: 10;
    font-weight: bold;
    text-align: center;
    justify-content: center;
    color: #ffffff;
    background-color: #2c4a6b;
    border-radius: 6;
    cursor: pointer;
  }
  .uix-hand-menu-button:hover { background-color: #3d648e; }
  .uix-hand-menu-button:active { background-color: #1f3a55; }
</style>
<div id="uix-window" class="uix-hand-menu">
  <div id="uix-content" class="uix-hand-menu-stack">
    <div id="menu-hide" class="uix-hand-menu-button">HIDE</div>
    <div id="menu-pin" class="uix-hand-menu-button">PIN</div>
    <div id="menu-home" class="uix-hand-menu-button">HOME</div>
    <div id="menu-minimize" class="uix-hand-menu-button">MIN</div>
    <div id="menu-chrome" class="uix-hand-menu-button">BUTTONS ON</div>
    <div id="menu-close" class="uix-hand-menu-button">CLOSE</div>
  </div>
</div>
