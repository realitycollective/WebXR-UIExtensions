{
  "name": "@realitycollective/iwsdk-uiextensions",
  "version": "0.1.2-preview.1",
  "description": "Meta IWSDK adapter for the Reality Collective UI Extensions - windowing, docking, layout regions and extra controls, binding the engine-free @realitycollective/webxr-uiextensions core onto IWSDK's ECS, UIKitML and interaction systems.",
  "keywords": [
    "realitycollective",
    "iwsdk",
    "webxr",
    "vr",
    "xr",
    "ui",
    "windowing",
    "uikitml",
    "spatial-ui",
    "typescript",
    "hand-menu",
    "pointer",
    "docking"
  ],
  "license": "MIT",
  "author": "Reality Collective",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "Examples",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drawcall/uikitml": "0.1.8",
    "zod": "^4.4.3",
    "@pmndrs/handle": "^6.6.31",
    "@realitycollective/webxr-input": "^0.1.9",
    "@realitycollective/webxr-uiextensions": "^0.1.2-preview.1"
  },
  "peerDependencies": {
    "@iwsdk/core": ">=1.0.0 <2.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@iwsdk/core": "1.0.1",
    "three": "npm:super-three@0.185.0",
    "@types/three": "0.185.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realitycollective/WebXR-UIExtensions.git",
    "directory": "packages/iwsdk-uiextensions"
  },
  "homepage": "https://github.com/realitycollective/WebXR-UIExtensions#readme",
  "bugs": {
    "url": "https://github.com/realitycollective/WebXR-UIExtensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
